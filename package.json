{
  "name": "room-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "better-auth": "1.7.7",
    "dexie": "4.4.6",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "konva": "10.7.1",
    "lucide-react": "1.54.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.9",
    "wrangler": "4.149.0"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.4.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply room-planner-local --local",
    "types": "wrangler types --strict-vars false",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:worker && pnpm build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
